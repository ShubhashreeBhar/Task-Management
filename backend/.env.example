# Port the Express server listens on
PORT=4000

# MongoDB connection string (get this from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# A long, random secret used to sign JWTs — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Comma-separated list of allowed frontend origins for CORS
# Add your Vercel deployment URL here alongside localhost
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app
